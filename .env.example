# Copy to .env and fill in. Nothing here is needed to run the tests.

# --- Database -----------------------------------------------------------------
# Matches docker-compose.yml. Host port is 5433 to avoid clashing with a local Postgres.
DATABASE_URL=postgresql+psycopg://vide:vide@localhost:5433/vide

# --- LLM provider -------------------------------------------------------
# Required: the breakdown extractor and entity resolver are LLM calls.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. When set, tiers can route Claude tasks natively instead of through
# OpenRouter — that path adds schema-guaranteed JSON output, prompt caching and
# the Batches API. Leave blank to send everything via OpenRouter.
ANTHROPIC_API_KEY=

# --- Image / video provider ---------------------------------------------
# Not needed until image generation. The adapter is stubbed until then.
HIGGSFIELD_API_KEY=

# --- Object storage --------------------------------------------------
# Not needed until later stages either — Stage 1 up to and including later stages produces no binaries.
# Any S3-compatible endpoint works (MinIO locally, S3/R2/GCS in deployment).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- App ----------------------------------------------------------------------
LOG_LEVEL=INFO
